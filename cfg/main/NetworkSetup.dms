container NetworkSetup : using = "units;Geography;SourceData;Classifications"
{
	container StudentAccess_Analysis :=
		Call_CreateNetwork_T(
			 Analyses/StudentAccessibility/Org   //Org
			,Analyses/StudentAccessibility/Dest  //Dest
			,'StudentAccessibility'
		);
		
	container ExistingSchool_Analysis :=
		Call_CreateNetwork_T(
			 Analyses/AllocateKidsToExistingSchools/Org   //Org
			,Analyses/AllocateKidsToExistingSchools/Dest  //Dest
			,'ExistingSchools'
		);
		
	container NewSchool_Analysis :=
		Call_CreateNetwork_T(
			 Analyses/AllocateKidsToNewSchools/Org   //Org
			,Analyses/AllocateKidsToNewSchools/Dest  //Dest
			,'NewSchools'
		);

	container ExistingPharmacy_Analysis :=
		Call_CreateNetwork_T(
			Analyses/AllocateClientsToExistingPharmacies/Org   //Org
			,Analyses/AllocateClientsToExistingPharmacies/Dest  //Dest
			,'ExistingPharmacies'
		);
		
	container NewPharmacy_Analysis :=
		Call_CreateNetwork_T(
			Analyses/AllocateClientsToNewPharmacies/Org   //Org
			,Analyses/AllocateClientsToNewPharmacies/Dest  //Dest
			,'NewPharmacies'
		);
	container s1Pharmacy_Analysis:= 
		Call_CreateNetwork_T(
			Analyses/AllocateClientsTos1Pharmacies/Org   //Org
			,Analyses/AllocateClientsTos1Pharmacies/Dest  //Dest
			,'s1Pharmacies'
		);
	container s2Pharmacy_Analysis:= 
		Call_CreateNetwork_T(
			Analyses/AllocateClientsTos2Pharmacies/Org   //Org
			,Analyses/AllocateClientsTos2Pharmacies/Dest  //Dest
			,'s2Pharmacies'
		);
	Template Call_CreateNetwork_T
	{
		unit<uint32>      Org;
		unit<uint32>      Dest;
		parameter<string> ProjName;
		///
		
		container NetwerkSpec :=
			Templates/CreateNetwork_T(
				  org
				, dest
				, SourceData/Infrastructure/TomTom/Streets 
				, SourceData/Infrastructure/TomTom/Junctions 
			);
		
		
		parameter<string> Generator_Network1         := 'Ready', ExplicitSuppliers = "NetwerkSpec/CreateInitialWorkingNetwork/LinkSet_Write";
		parameter<string> Generator_Network2         := 'Ready', ExplicitSuppliers = "NetwerkSpec/CreateMoreEfficientNetwork/Write_FinalSet";
		parameter<string> Export_Cleaned_RoadNetwork := 'Ready', explicitsuppliers = "NetwerkSpec/CreateMoreEfficientNetwork/FinalSet/FinalLinkSet/store/store";
	}
}
