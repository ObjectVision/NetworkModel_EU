container Classifications: Using = "Units"
{
	#include<osm.dms>
	
	container TomTom
	{
		unit<uint32> Directions: NrOfRows = 4
		{
			attribute<string> code: ['','N','FT','TF'];
			attribute<string> Label: ['dual', 'nocars', 'forwards', 'backwards'];
			
			container V := for_each_nedv(Label, String(ID(.))+'[..]', void, .);
		}
		unit<int32> FuncRoadClass_EK := range(int32, -1i, 9i);
		unit<uint8> FuncRoadClass : nrofrows = 10
		{
			attribute<string> Label : ['Not Applicable', 'Motorway, Freeway, or Other Major Road', 'Major Road Less Important than a Motorway', 'Other Major Road','Secondary Road','Local Connecting Road','Local Road of High Importance','Local Road','Local Road of Minor Importance','Other Road'];
			attribute<string> name := AsItemName(label);
			attribute<RegioRoadCategory> RRC_rel: [0, 1, null, null, 2, 2, 3, 3, 3, 3];
			container V := for_each_nedv(name, String(ID(.))+'[..]', void, .);
			
		/* From the DG REGIO report (https://ec.europa.eu/regional_policy/sources/work/road-2022/road-infrastructure-2022.pdf)
			Motorways and other main roads: motorways, main
			roads, roads of major importance and major roads that are
			at least dual carriageways, i.e. with at least two lanes going
			each way.
			Ý Secondary roads: roads of major importance and major
			roads that are single carriageways, secondary roads and
			local connecting roads.
			Ý Local roads: local roads of high importance, local roads,
			local roads of minor importance and other roads.
			
			NULL values to be filled in the streets section, depend on nr of lanes
		*/
		}
		unit<uint8> RegioRoadCategory : nrofrows = 5 {
			attribute<string> Label : ['Not Applicable', 'Motorways and other main roads', 'Secondary roads', 'Local roads', 'Simulated connectors'];
			attribute<string> name := AsItemName(label);
			container V := for_each_nedv(name, String(ID(.))+'[..]', void, .);
		}
	}
	
	unit<uint8> SchoolLevel := cat_range(0b, 9b)
	{
		attribute<string> label : 
		[
			  'Pre-Primary education'          //0  kleuter
			, 'Primary education'              //1  basis
			, 'Lower secondary education'      //2  middelbaar
			, 'Upper secondary education'      //3  middelbaar
			, 'Post secondary education'       //4  praktisch?
			, 'Short-cycle tertiary education' //5  praktisch?
			, 'Bachelors or equivalent level'  //6  uni
			, 'Masters or equivalent level'    //7  uni
			, 'Doctoral or equivalent level'   //8  uni
			
		];
		attribute<string> name := AsItemName(label);
		container V := for_each_nedv(name, String(ID(.))+'[..]', void, .);
	}

	unit<uint32> SexAgeClasses := combine(Sex, AgeClasses)
	{
		attribute<Sex>                  Sex_rel                := first_rel;
		attribute<AgeClasses>           AgeClasses_rel         := second_rel;
		attribute<string>               Gender_name            := Sex/label[first_rel];
		attribute<string>               AgeClass_name          := AgeClasses/label[second_rel];
		// attribute<bool>                 IsOver65               := AgeClasses/IsOver65[second_rel];
		attribute<uint32>               from                   := AgeClasses/from[second_rel];
		attribute<string>               name                   := Gender_name + '_' + AgeClass_name;
		attribute<string>               label                  := name;
		// attribute<string>				AgeClasses_readable	   := AgeClasses/AgeClasses_readable[second_rel], descr = "Used for reporting (ad hoc reporting unit)";
		// attribute<string> 				RepAgeClasses_readable := AgeClasses/RepAgeClasses_readable[second_rel], descr = "Used for reporting (ad hoc reporting unit)";
		
		container V := for_each_nedv(name, String(ID(.))+'[..]', void, .);
	}

	unit<uint32> Sex : NrOfRows = 2
	, Descr = "Sex classes" 
	{
		attribute<string> Label : ['F','M'], descr = "descriptive name of gender class";
		attribute<string> name := label;
		container V := for_each_nedv(label, String(ID(.))+'[..]', void, .);
	}

	unit<uint32> AgeClasses : NrOfRows =  18
	, Descr = "Definition of narrow (5y) age classes that are allocated separately" 
	{
		attribute<uint32>         from                                        := id(.) * 5, descr = "start of age class";
		attribute<uint32>         to                                          := id(.) < max(id(.)) ? ((id(.) + 1) * 5) - 1 : 150, descr = "end of age class";
		attribute<string>         Label                                       := id(.) < max(id(.)) 
																					? to < 10
																						? 'Y0'+string(from) + '_0'+string(to) 
																						: 'Y'+string(from) + '_'+string(to) 
																					: 'Over85', descr = "descriptive name of age class";
	}
	
	unit<uint8> ClientTravelTimeK := cat_range(0b, 9b)
	{
		attribute<string>  label       := id(.) == max(id(.)) ? '> '+last(string(ClassBreaks))+' min' : name + ' - ' +next_name+' min';
		attribute<float64> ClassBreaks : [0, 2, 4, 6, 8, 10, 20, 30, 60];
		attribute<string>  name        := string(ClassBreaks); 
		attribute<string>  next_name   := name[add_or_null(id(.),1b)];
		attribute<uint32>  SymbolColor : [rgb(0,104,55),rgb(49,163,84),rgb(120,198,121),rgb(194,230,153),rgb(255,255,178),rgb(254,217,142),rgb(253,174,97),rgb(215,48,39),rgb(127,0,0)];
	}
}