	unit<uint32> Schools 
	: StorageName = "%NetworkModelDataDir%/Locations/EU_schools_2023_downloaded_20260327_fixed.csv"
	, StorageType = "gdal.vect"
	, StorageReadOnly = "True"
	{
		attribute<wgs84_base>     geometry_wgs           := point_xy(float64(lon), float64(lat), wgs84_base);
		attribute<BaseProjection> geometry               := geometry_wgs[BaseProjection];
		// attribute<Base_grid>      Base_grid_rel          := geometry[Base_grid];
		
		container check_schoollevel:= 
			for_each_nedv(
				Schoollevel/Name
				, 'strcount(levels_fixed, '+quote(string(id(Schoollevel)))+') > 0'
				, Schools
				, bool
			);
		
		attribute<bool>           IsStudyArea  := IsDefined(point_in_polygon(geometry, /SourceData/RegionalUnits/Country/subset/geometry));
		
		unit<uint32> within_StudyArea := select_with_org_rel(IsStudyArea)
		{
			attribute<BaseProjection>       geometry                     := org_rel -> geometry;
			attribute<Base_grid>            Base_grid_rel                := geometry[Base_grid];
			attribute<uq_school_cells>      uq_school_cells_rel          := rlookup(Base_grid_rel, uq_school_cells/values);
			
			unit<uint32> uq_school_cells := unique(./Base_grid_rel)
			{
				attribute<Base_grid>      Base_grid_rel := values;
				attribute<BaseProjection> geometry               := values[BaseProjection] + Base_grid/center_delta;
				attribute<float32>        Count_Objects_Per_Cell := float32(pcount(uq_school_cells_rel));
				attribute<float32>        CountCurrentObjects    := float32(pcount(uq_school_cells_rel));
				
				attribute<uint32>         CountSchools_grid (Base_grid) := MakeDefined(sum(CountCurrentObjects, Base_grid_rel)[uint32], 0);
			}
		}
	}
	container Pharmacies
	{
		unit<uint8> Country := range(0b, 19b) //should be 20b, Finland taken out because of spatial_reference problem (see issue #44)
		{
			attribute<string> Name : ['Austria', 'Belgium', 'Czechia', 'Denmark', 'Estonia', 'France', 'Ireland', 'Iceland', 'Italy', 'Lithuania', 'Luxembourg', 'Latvia', 'Netherlands', 'Norway', 'Poland', 'Portugal', 'Slovenia', 'Sweden', 'Hungary']; // 'Finland',
			attribute<string> Label := Name;
			attribute<string> Code : ['aut', 'bel', 'cze', 'dnk', 'est', 'fra', 'irl', 'isl', 'ita', 'ltu', 'lux', 'lva', 'nld', 'nor', 'pol', 'prt', 'svn', 'swe', 'hun']; //'fin',
			attribute</SourceData/RegionalUnits/Country/subset> Country_rel:= rlookup(Name, /SourceData/RegionalUnits/Country/subset/NAME_ENGL);
			// Every country is a parquet with lat/lon columns, read via CountryDataT.
			// Italy (issue #53, OECD delivery of 7 Sep 2026): the Ministry of Health list,
			// 20,635 pharmacies, geolocated by the OECD (Mapbox > ArcGIS > manual; 28 of 30
			// rural checks correct) because the official coordinates were duplicated or
			// implausible. It replaces the ESPON 2021 point shapefile (12,991 pharmacies,
			// read through CountryDataShpT until 10 Sep 2026); the June 2026 unchecked
			// parquet is kept beside it as ita_pharmacies_20260622_unchecked.parquet.
			// Hungary (same delivery): 3,094 pharmacies, geocoded by the OECD from a
			// coordinate-less source; records starting with "DR." removed (accuracy 76% → 90%).
			attribute<string> FileName   := '%NetworkModelDataDir%/Locations/pharmacies/'+Code+'_pharmacies.parquet';
			attribute<string> Calculator := 'CountryDataT("'+FileName+'")';
			container V := for_each_nedv(Name, string(ID(.))+'[..]', void, .);
		}
		// Countries whose pharmacy parquet is actually present. Chris's data arrives
		// country-by-country, so EU is unioned over THESE only — a missing-country file
		// then never breaks the whole pharmacy pipeline. Each Name must also appear in
		// Country/Name above; ADD A NAME HERE (and bump nrofrows) as each parquet lands.
		unit<uint32> AvailableCountry : nrofrows = 19
		{
			attribute<string> Name : ['Austria', 'Belgium', 'Czechia', 'Denmark', 'Estonia', 'France', 'Ireland', 'Iceland', 'Italy', 'Lithuania', 'Luxembourg', 'Latvia', 'Netherlands', 'Norway', 'Poland', 'Portugal', 'Slovenia', 'Sweden', 'Hungary']; // all enum countries now have a parquet (Finland still excluded, issue #44)

		}
		template CountryDataT
		{
			parameter<string> fileName;
			unit<uint32> Table
			: StorageName = "=FileName"
			, StorageType = "gdal.vect"
			, StorageReadOnly = "True"
			{
				attribute<geography/wgs84_base> geometry_wgs:= point_yx(lat, lon, geography/wgs84_base);
				attribute<geography/BaseProjection> geometry := geometry_wgs[geography/BaseProjection];
			}
		}
		// Variant for point shapefiles that carry a native (CRS-tagged) geometry instead of
		// separate lat/lon columns. Used for Italy's ESPON 2021 pharmacy .shp until the OECD
		// parquet replaced it (issue #53); kept for the next delivery of that shape. The
		// geometry is read directly and reprojected to BaseProjection; downstream (EU union
		// etc.) only uses Table + Table/geometry, so it is interchangeable with CountryDataT.
		template CountryDataShpT
		{
			parameter<string> fileName;
			unit<uint32> Table
			: StorageName = "=FileName"
			, StorageType = "gdal.vect"
			, StorageReadOnly = "True"
			{
				attribute<geography/wgs84_base>     geometry_wgs;
				attribute<geography/BaseProjection> geometry := geometry_wgs[geography/BaseProjection];
			}
		}
		container Countries := for_each_ne(Country/Name, Country/Calculator);
		unit<uint32> EU := ='union_unit('+AsItemList('Countries/'+AvailableCountry/Name+'/Table')+')'
		{
			attribute<Country>                  Country_rel := ='union_data(., '+AsItemList('const(Country/V/'+AvailableCountry/Name+', Countries/'+AvailableCountry/Name+'/Table)')+')';
			attribute<geography/BaseProjection> geometry    := ='union_data(., '+AsItemList('Countries/'+AvailableCountry/Name+'/Table/geometry')+')';
			attribute<bool>           IsStudyArea  := = /ModelParameters/Use_NUTS1_selection 
			? 'IsDefined(point_in_polygon(geometry, /SourceData/RegionalUnits/NUTS1/Subset/geometry))'
			: 'IsDefined(point_in_polygon(geometry, /SourceData/RegionalUnits/Country/subset/geometry))';
		}
		unit<uint32> within_StudyArea := select_with_org_rel(EU/IsStudyArea)
		{
			attribute<BaseProjection> geometry      := org_rel -> geometry;
			attribute<Base_grid>      Base_grid_rel := geometry[Base_grid];
			attribute<uq_cells>       uq_cells_rel  := rlookup(Base_grid_rel, uq_cells/values);
			attribute<Country> 		  File_Country_rel:= EU/Country_rel[org_rel];
			attribute</SourceData/RegionalUnits/Country/subset> Country_rel:= Country/Country_rel[File_Country_rel];
			
			unit<uint32> uq_cells := unique(./Base_grid_rel)
			{
				attribute<Base_grid>      Base_grid_rel := values;
				attribute<BaseProjection> geometry               := values[BaseProjection] + Base_grid/center_delta;
				attribute<float32>        Count_Objects_Per_Cell := float32(pcount(uq_cells_rel));
				attribute<float32>        CountCurrentObjects    := float32(pcount(uq_cells_rel));
				attribute</SourceData/RegionalUnits/Country/subset> Country_rel:= modus(within_StudyArea/Country_rel, uq_cells_rel);
				attribute<string> 		  Country_Code			 := SourceData/RegionalUnits/Country/subset/ISO3_Code[Country_rel];
				attribute<uint32>         Count_grid (Base_grid) := MakeDefined(sum(CountCurrentObjects, Base_grid_rel)[uint32], 0);
			}
		}
	}
	unit<ipoint> Base_grid := ='/Geography/Base_grid_'+ModelParameters/OrgGridsize;
	
	unit<uint32> NewSchoolLocations := select_with_org_rel(/Geography/Base_grid_1km/points/population >= ModelParameters/MinPopSizeVoorPotentialSchoolLocation)
	{
		attribute<BaseProjection> geometry            := org_rel -> geometry;
		attribute<bool>           IsStudyArea         := IsDefined(point_in_polygon(geometry, /SourceData/RegionalUnits/Country/subset/geometry));
		
		unit<uint32> within_StudyArea := select_with_org_rel(IsStudyArea)
		{
			attribute<BaseProjection>       geometry                     := org_rel -> geometry;
			attribute<Base_grid>            Base_grid_rel                := geometry[Base_grid];
			attribute<float32>              Count_Objects_Per_Cell       := const(1f, .);
			attribute<float32>              CountCurrentObjects          := rjoin(Base_grid_rel, Schools/within_StudyArea/uq_school_cells/Base_grid_rel, Schools/within_StudyArea/uq_school_cells/CountCurrentObjects);
		}
	}
	// Candidate pharmacy locations (doc/todo.md A1; 24-Jun thread + methodology draft
	// §2.2.1): every grid cell with >= MinPopSizeForPharmacyLocation (50) inhabitants
	// PLUS every cell that currently contains a pharmacy (~2% of pharmacies lie in
	// <50-pop cells and must stay selectable). No longer an alias of NewSchoolLocations:
	// that alias also joined CountCurrentObjects against SCHOOLS, so the OD's
	// nearest-5-current-facilities limit counted school cells in pharmacy runs.
	// Issue #49: the candidate set carries the SAME coverage filter as ModelClient --
	// only countries for which pharmacy supply data exists. With lambda > 0 the LP would
	// never open a facility that serves nobody, so the optimum is unchanged; this keeps
	// the candidate universe consistent with the client universe and stops the reported
	// candidate count M from including cells that can never be selected.
	unit<uint32> NewPharmacyLocations := select_with_org_rel(
			   (
			      /Geography/Base_grid_1km/points/population >= ModelParameters/MinPopSizeForPharmacyLocation
			   || IsDefined(rlookup(/Geography/Base_grid_1km/points/geometry[Base_grid], Pharmacies/within_StudyArea/uq_cells/values))
			   )
			&& /Analyses/covered_country[/Geography/Base_grid_1km/points/Country_rel]
		)
	{
		attribute<BaseProjection> geometry            := org_rel -> geometry;
		attribute<bool>           IsStudyArea         := = /ModelParameters/Use_NUTS1_selection
			? 'IsDefined(point_in_polygon(geometry, /SourceData/RegionalUnits/NUTS1/Subset/geometry))'
			: 'IsDefined(point_in_polygon(geometry, /SourceData/RegionalUnits/Country/subset/geometry))';

		unit<uint32> within_StudyArea := select_with_org_rel(IsStudyArea)
		{
			attribute<BaseProjection>       geometry                     := org_rel -> geometry;
			attribute<Base_grid>            Base_grid_rel                := geometry[Base_grid];
			attribute<float32>              Count_Objects_Per_Cell       := const(1f, .);
			attribute<float32>              CountCurrentObjects          := MakeDefined(rjoin(Base_grid_rel, Pharmacies/within_StudyArea/uq_cells/Base_grid_rel, Pharmacies/within_StudyArea/uq_cells/CountCurrentObjects), 0f);
		}
	}
	
	unit<uint32> services_allocated:= range(uint32, 0, 21) {
		attribute<string> country: ['Austria','Czechia','Denmark','Estonia','FR1','FRB','FRD','FRG','FRI','FRJ','FRK','FRM','ITF','ITG','Norway','PL2','PL5','PL6','PL7','PL9','SE1'];
		attribute<string> s1_logistic:= country+'_s1_logistic_open.arrow';
		attribute<string> s2_logistic:= country+'_s2_logistic_open.arrow';
		attribute<string> s1_linear:= country+'_s1_linear_open.arrow';
		attribute<string> s2_linear:= country+'_s2_linear_open.arrow';
	
		container resultfiles_s1_logistic:= for_each_ne(country, 'readresultfiles('+quote('D:/sourcedata/NetworkModel_EU/Locations/service_access_202608/'+s1_logistic)+', '+quote('s1_logistic')+')') {
			unit<uint32> all:= ='union_unit('+asitemlist(country+'/infile')+')' {
				attribute<LambertEA> geometry:= ='union_data(.,'+asitemlist(country+'/infile/geometry')+')';
				attribute<string> alloctype:= ='union_data(.,'+asitemlist(country+'/infile/alloctype')+')';
				attribute<string> runregion:= ='union_data(.,'+asitemlist(country+'/infile/runregion')+')';
				attribute<unique> uq_rel:= rlookup(geometry, unique/geometry);
			}
			unit<uint32> unique:= unique(all/geometry) {
				attribute<LambertEA> geometry:= values;
				attribute<bool>           IsStudyArea         := IsDefined(point_in_polygon(geometry, /SourceData/RegionalUnits/Country/subset/geometry));
				
				unit<uint32> within_StudyArea := select_with_org_rel(IsStudyArea)
				{
					attribute<BaseProjection>       geometry                     := org_rel -> geometry;
					attribute<Base_grid>            Base_grid_rel                := geometry[Base_grid];
					attribute<float32>              Count_Objects_Per_Cell       := const(1f, .);
					attribute<float32>              CountCurrentObjects          := rjoin(Base_grid_rel, Schools/within_StudyArea/uq_school_cells/Base_grid_rel, Schools/within_StudyArea/uq_school_cells/CountCurrentObjects);
				}
			}
		}
		container resultfiles_s2_logistic:= for_each_ne(country, 'readresultfiles('+quote('D:/sourcedata/NetworkModel_EU/Locations/service_access_202608/'+s2_logistic)+', '+quote('s2_logistic')+')') {
			unit<uint32> all:= ='union_unit('+asitemlist(country+'/infile')+')' {
				attribute<LambertEA> geometry:= ='union_data(.,'+asitemlist(country+'/infile/geometry')+')';
				attribute<string> alloctype:= ='union_data(.,'+asitemlist(country+'/infile/alloctype')+')';
				attribute<string> runregion:= ='union_data(.,'+asitemlist(country+'/infile/runregion')+')';
				attribute<unique> uq_rel:= rlookup(geometry, unique/geometry);
			}
			unit<uint32> unique:= unique(all/geometry) {
				attribute<LambertEA> geometry:= values;
				attribute<bool>           IsStudyArea         := IsDefined(point_in_polygon(geometry, /SourceData/RegionalUnits/Country/subset/geometry));
				
				unit<uint32> within_StudyArea := select_with_org_rel(IsStudyArea)
				{
					attribute<BaseProjection>       geometry                     := org_rel -> geometry;
					attribute<Base_grid>            Base_grid_rel                := geometry[Base_grid];
					attribute<float32>              Count_Objects_Per_Cell       := const(1f, .);
					attribute<float32>              CountCurrentObjects          := rjoin(Base_grid_rel, Schools/within_StudyArea/uq_school_cells/Base_grid_rel, Schools/within_StudyArea/uq_school_cells/CountCurrentObjects);
				}
			}
		}

		
	
	}
	Template readresultfiles {
		parameter<string> filepath;
		parameter<string> type;
		parameter<string> region:= propvalue(., 'name');
		
		unit<uint32> infile: StorageName = "= filepath", storagetype = "gdal.vect" {
			attribute<LambertEA> geometry:= point_xy(x, y, LambertEA);
			attribute<string>    alloctype:= const(type,.,string);
			attribute<string> 	 runregion:= const(region, ., string);
		}
	
	}
	
	
}