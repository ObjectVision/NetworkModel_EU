container Locations : using = "geography;units"
{
	container Pop_2011_per_SexAgeClasses := 
		for_each_ndvat(
			SexAgeClasses/name
			, Base_Grid_100m
			, float32
			, '%NetworkModelDataDir%/Population/EU_Ardeco_2011_100_x0/'+SexAgeClasses/name+'.tif'
			, 'gdal.grid'
		)
	{
		// primary school age = 6 tm 12 year.
		attribute<float32> pop_primaryschool (Base_Grid_100m) := F_Y05_09 * 0.8f + M_Y05_09 * 0.8f + F_Y10_14 * 0.6f + M_Y10_14 * 0.6f;
	
	}
	container Pop_2021_per_SexAgeClasses := 
		for_each_ndvat(
			SexAgeClasses/name
			, Base_Grid_100m
			, float32
			, '%NetworkModelDataDir%/Population/EU_Ardeco_2021_100_x0/'+SexAgeClasses/name+'.tif'
			, 'gdal.grid'
		)
	{
		// primary school age = 6 tm 12 year.
		attribute<float32> pop_primaryschool (Base_Grid_100m) := F_Y05_09 * 0.8f + M_Y05_09 * 0.8f + F_Y10_14 * 0.6f + M_Y10_14 * 0.6f;
	
	}
	
	attribute<float32> Pop_primaryschool (Base_Grid_1km) := ='sum(Pop_'+ModelParameters/IGOR_Pop_year+'_per_SexAgeClasses/pop_primaryschool, Base_Grid_100m/grid_1k_rel)';

	unit<ipoint> Population_IGOR_Total := ='Population_'+ModelParameters/IGOR_Pop_year+'_IGOR_Total';
	
	unit<ipoint> Population_2011_IGOR_Total
	: StorageName = "%NetworkModelDataDir%/Population/EU_Ardeco_2011_100_x0/Total.tif"
	, StorageType = "gdal.grid"
	, StorageReadOnly = "True"
	, DialogData = "BaseProjection"
	, DialogType = "map"
	, Descr = "IGOR output totals"
	{
		attribute<uint16> GridData;
		attribute<uint16> ReadData (Base_Grid_100m);
	}
	
	unit<ipoint> Population_2021_IGOR_Total
	: StorageName = "%NetworkModelDataDir%/Population/EU_Ardeco_2021_100_x0/Total.tif"
	, StorageType = "gdal.grid"
	, StorageReadOnly = "True"
	, DialogData = "BaseProjection"
	, DialogType = "map"
	, Descr = "IGOR output totals"
	{
		attribute<uint16> GridData;
		attribute<uint16> ReadData (Base_Grid_100m);
	}

	unit<ipoint> Population_2011_Ardeco
	: StorageName = "%NetworkModelDataDir%/Population/pop_2011_1km_ARDECO.tif"
	, StorageType = "gdal.grid"
	, StorageReadOnly = "True"
	, DialogData = "BaseProjection"
	, DialogType = "map"
	, Descr = "JRC GeoStat 2011 1000m grid: Ardeco scaled to national totals"
	{
		attribute<uint16> GridData;
		attribute<uint16> ReadData (Base_Grid_1km);
	}
	unit<ipoint> Population_2021_Ardeco
	: StorageName = "%NetworkModelDataDir%/Population/pop_2021_1km_ARDECO.tif"
	, StorageType = "gdal.grid"
	, StorageReadOnly = "True"
	, DialogData = "BaseProjection"
	, DialogType = "map"
	, Descr = "JRC GeoStat 2021 1000m grid (v2): Ardeco scaled to national totals"
	{
		attribute<uint32>  GridData;
		attribute<uint32>  ReadData       (Base_Grid_1km);
		// attribute<float64> LocalPotential (Base_Grid_1km)  := ='potential(ReadData[float64], Geography/Distmatrices/Impl/pot5000m/potRange/rev_dist_scaled)';
	}
	unit<ipoint> Degurba_2021
	: StorageName = "%NetworkModelDataDir%/Population/DGUR_LEVEL2_GRD_1KM_2021.tif"
	, StorageType = "gdal.grid"
	, StorageReadOnly = "True"
	, DialogData = "BaseProjection"
	, DialogType = "map"
	, Descr = "Eurostat degurba grid based on 2021 population grid"
	{
		attribute<uint32>  GridData;
		attribute<uint32>  ReadData       (Base_Grid_1km);
		//attribute<uint8> 	Values (LambertEA/m1000): expr = "ReadData > 99i ? uint8(0 / 0) : uint8(ReadData)";
		
		attribute<Degrees_Of_Urbanization> degurba 								(Base_Grid_1km): 	expr = "Degrees_of_urbanization_lvl2/degurba_lv1[degurba_lvl2]";
		attribute<Degrees_of_urbanization_lvl2>		degurba_lvl2 				(Base_Grid_1km): expr = "rlookup(ReadData, Degrees_of_urbanization_lvl2/class_start)";
		//attribute<Degrees_of_urbanization_plus_citysize> degurba_city 			(Base_Grid_1km): expr = "(degurba < 3 ? degurba : degurba + settclass)[Degrees_of_urbanization_plus_citysize]";
		//attribute<Degrees_of_urbanization_lvl2_plus_citysize> degurba_lv2_city	(Base_Grid_1km): expr = "(degurba_lvl2 < 5 ? degurba_lvl2 : degurba_lvl2 + settclass)[Degrees_of_urbanization_lvl2_plus_citysize]";
		
		unit<uint32> Degrees_of_urbanization_lvl2: NrOfRows = 8 {
			attribute<uint32>  class_start: 	[310, 311, 312, 313, 221, 222, 223, 130];
			attribute<string> LabelText: 	['Water', 'Mostly uninhabited', 'Dispersed rural', 'Villages', 'Suburbs', 'Semi-dense urban clusters', 'Dense urban clusters', 'Cities'];
			attribute<string> Single_Name:	['Water', 'mostly uninhabited', 'dispersed rural', 'village', 'suburb', 'Semi-dense urban clusters', 'Dense urban clusters', 'city'];
			attribute<bool>	  Settlement:= class_start = 313 || class_start > 221;
			attribute<Degrees_Of_Urbanization> degurba_lv1: [0,0,0,1,2,2,2,3];
		}
		unit<uint32> Degrees_of_urbanization: NrOfRows = 4 {
			attribute<string>  LabelText: ['Sparse rural', 'Village', 'Towns and suburbs', 'Cities'];
		}
		// attribute<float64> LocalPotential (Base_Grid_1km)  := ='potential(ReadData[float64], Geography/Distmatrices/Impl/pot5000m/potRange/rev_dist_scaled)';
	}
	unit<ipoint> Population := = 'Population_'+string(ModelParameters/PopVersie); 
	
