container Analyses: Using = "Units;Classifications;geography;sourcedata" 
{  
	unit<uint32> Client       := ='select_with_attr_by_cond(Base_grid_'+ModelParameters/DestGridsize+'/points, Base_grid_'+ModelParameters/DestGridsize+'/points/'+ModelParameters/Client+' > 0)';

	container Pharmacies
	{
		unit<uint32> locations := SourceData/Locations/Pharmacies/within_StudyArea;

		// --- Descriptive indicators of the OBSERVED pharmacy distribution -------
		// (Lewis, 22 May). Per StudyArea; each user assigned to the nearest pharmacy
		// cell (Euclidean), residents = total population. Exports one Arrow row per
		// StudyArea; make_descriptive_table.bat loops the study areas and collects them.
		container Descriptives: using = "geography;sourcedata"
		{
			unit<uint32> pharm := Locations/Pharmacies/within_StudyArea;          // raw pharmacy points
			unit<uint32> cells := Locations/Pharmacies/within_StudyArea/uq_cells; // unique pharmacy cells
			unit<uint32> grid  := Base_grid_1km/points;                           // study-area 1km cells

			attribute<float32> cnt (cells) := Locations/Pharmacies/within_StudyArea/uq_cells/Count_Objects_Per_Cell;

			// --- nearest pharmacy CELL per 1km cell ---------------------------------
			// Euclidean straight-line nearest (kept for reference / comparison):
			attribute<cells> nearest_cell_euclid (grid) := connect(Locations/Pharmacies/within_StudyArea/uq_cells/geometry, Base_grid_1km/points/geometry);

			// Road-network nearest, derived from the existing-pharmacy Allocation (OD road
			// impedance). Per client we take the lowest-impedance pharmacy, then relate that
			// per-client result back to the 1km grid:
			//   best_od                      : per client, the OD row of minimum road impedance
			//                                  (min_index -> domain Client, value = an Alloc row)
			//   nearest_cell_by_road_client  : that row's pharmacy cell (Facility == cells)
			//   grid_client_rel              : per 1km grid cell, its client index, matched on the
			//                                  shared 1km grid domain (grid_domain_rel). null where
			//                                  the cell is not an OD client (ModelParameters/Client
			//                                  == 0, or no pharmacy within max_traveltime_to_facility)
			//   nearest_cell_by_road         : road-nearest pharmacy cell per 1km grid cell
			// (use the full Allocation path, not a unit alias — a `unit := other` alias
			//  does not expose the other's named sub-items like /facility_rel)
			attribute<AllocateClientsToExistingPharmacies/Allocation>
			                  best_od                     (Client) := min_index(AllocateClientsToExistingPharmacies/Allocation/impedance, AllocateClientsToExistingPharmacies/Allocation/client_rel);
			attribute<cells>  nearest_cell_by_road_client (Client) := AllocateClientsToExistingPharmacies/Allocation/facility_rel[best_od];
			attribute<Client> grid_client_rel             (grid)   := rlookup(Base_grid_1km/points/grid_domain_rel, Client/grid_domain_rel);
			attribute<cells>  nearest_cell_by_road        (grid)   := nearest_cell_by_road_client[grid_client_rel];

			// Catchment is ROAD-based: each 1km cell's residents go to its road-nearest pharmacy
			// cell. Only OD-client cells carry a road-nearest, so the catchment covers the resident
			// population of those cells; to cover ALL residents point ModelParameters/Client at
			// 'population' instead of 'pop_primaryschool' (then the OD spans every inhabited cell).
			attribute<float64> cell_catchment (cells) := sum(float64(Base_grid_1km/points/Population), nearest_cell_by_road), Descr = "Metric 6: residents whose nearest pharmacy cell (by road) is this one.";

			// per-pharmacy catchment: cell catchment shared equally among pharmacies in the cell
			attribute<float64> pharm_catchment (pharm) := cell_catchment[Locations/Pharmacies/within_StudyArea/uq_cells_rel] / float64(cnt[Locations/Pharmacies/within_StudyArea/uq_cells_rel]), Descr = "Metric 5: catchment per individual pharmacy.";

			// A 0-catchment pharmacy/cell is one that is never the road-nearest for any populated
			// cell (a fully shadowed neighbour, or — rarely — sitting on a disconnected road
			// fragment). Map those to null so min() reports the smallest NON-zero catchment, and
			// count them separately (n_empty) so the redundancy magnitude stays visible.
			attribute<float64> cell_catchment_nz  (cells) := cell_catchment  == 0d ? null_d : cell_catchment;
			attribute<float64> pharm_catchment_nz (pharm) := pharm_catchment == 0d ? null_d : pharm_catchment;

			parameter<uint32>  n_pharm := #pharm;
			parameter<uint32>  n_cells := #cells;
			parameter<float64> n_res   := sum(float64(Base_grid_1km/points/Population));

			unit<uint32> row1 := range(uint32, 0, 1);                  // single output row (this StudyArea)
			attribute<row1> c_rel (cells) := const(0, cells, row1);    // partition for cell percentiles
			attribute<row1> p_rel (pharm) := const(0, pharm, row1);    // partition for pharmacy percentiles

			parameter<string> GDAL_DRIVER := 'Arrow';
			container Table
			:	StorageName = "='%localDataProjDir%/Pharmacies_Descriptives/'+ModelParameters/StudyArea+'.arrow'"
			,	StorageType = "gdalwrite.vect"
			,	StorageReadOnly = "False"
			{
				attribute<string>  study_area             (row1) := const(ModelParameters/StudyArea, row1);
				attribute<uint32>  n_pharmacies           (row1) := const(n_pharm, row1);
				attribute<uint32>  n_pharmacy_cells       (row1) := const(n_cells, row1);
				attribute<float64> n_residents            (row1) := const(n_res, row1);
				attribute<float64> residents_per_pharmacy (row1) := const(n_res / float64(n_pharm), row1);
				attribute<uint32>  n_cells_multi          (row1) := const(sum(uint32(cnt > 1f)), row1);
				attribute<float64> avg_pharm_in_multi     (row1) := const(sum(float64(cnt) * float64(cnt > 1f)) / sum(float64(cnt > 1f)), row1);
				attribute<uint32>  max_pharm_in_cell      (row1) := const(uint32(max(cnt)), row1);

				// metric 6 — catchment population distribution, pharmacies combined per cell
				attribute<uint32>  cell_n_empty (row1) := const(sum(uint32(cell_catchment == 0d)), row1);  // #locations never road-nearest
				attribute<float64> cell_min_nz  (row1) := const(min(cell_catchment_nz), row1);             // smallest NON-zero catchment
				attribute<float64> cell_min (row1) := const(min(cell_catchment), row1);
				attribute<float64> cell_p10 (row1) := rth_element(cell_catchment, 0.10f, c_rel);
				attribute<float64> cell_p25 (row1) := rth_element(cell_catchment, 0.25f, c_rel);
				attribute<float64> cell_p50 (row1) := rth_element(cell_catchment, 0.50f, c_rel);
				attribute<float64> cell_p75 (row1) := rth_element(cell_catchment, 0.75f, c_rel);
				attribute<float64> cell_p90 (row1) := rth_element(cell_catchment, 0.90f, c_rel);
				attribute<float64> cell_max (row1) := const(max(cell_catchment), row1);
				attribute<float64> cell_avg (row1) := const(sum(cell_catchment) / float64(n_cells), row1);

				// metric 5 — catchment population distribution, per individual pharmacy
				attribute<uint32>  pharm_n_empty (row1) := const(sum(uint32(pharm_catchment == 0d)), row1);  // #pharmacies never road-nearest
				attribute<float64> pharm_min_nz  (row1) := const(min(pharm_catchment_nz), row1);             // smallest NON-zero catchment
				attribute<float64> pharm_min (row1) := const(min(pharm_catchment), row1);
				attribute<float64> pharm_p10 (row1) := rth_element(pharm_catchment, 0.10f, p_rel);
				attribute<float64> pharm_p25 (row1) := rth_element(pharm_catchment, 0.25f, p_rel);
				attribute<float64> pharm_p50 (row1) := rth_element(pharm_catchment, 0.50f, p_rel);
				attribute<float64> pharm_p75 (row1) := rth_element(pharm_catchment, 0.75f, p_rel);
				attribute<float64> pharm_p90 (row1) := rth_element(pharm_catchment, 0.90f, p_rel);
				attribute<float64> pharm_max (row1) := const(max(pharm_catchment), row1);
				attribute<float64> pharm_avg (row1) := const(sum(pharm_catchment) / float64(n_pharm), row1);
			}
		}
	}
	container AllocateClientsToExistingPharmacies:= 
		Allocate_T(
			  Client
			, SourceData/Locations/Pharmacies/within_StudyArea/uq_cells
			, NetworkSetup/ExistingPharmacy_Analysis/NetwerkSpec
			, NetworkSetup/ExistingPharmacy_Analysis/ProjName
		);
		
	container AllocateClientsToNewPharmacies:= 
		Allocate_T(
			  Client
			, SourceData/Locations/NewPharmacyLocations/within_StudyArea
			, NetworkSetup/NewPharmacy_Analysis/NetwerkSpec
			, NetworkSetup/NewPharmacy_Analysis/ProjName
		);
		
	container AllocateKidsToExistingSchools := 
		Allocate_T(
			  Client
			, SourceData/Locations/Schools/within_StudyArea/uq_school_cells
			, NetworkSetup/ExistingSchool_Analysis/NetwerkSpec
			, NetworkSetup/ExistingSchool_Analysis/ProjName
		);
		
	container AllocateKidsToNewSchools      := 
		Allocate_T(
			  Client
			, SourceData/Locations/NewSchoolLocations/within_StudyArea
			, NetworkSetup/NewSchool_Analysis/NetwerkSpec
			, NetworkSetup/NewSchool_Analysis/ProjName
		);

	parameter<string> GDAL_DRIVER := 'Arrow';
	Template ReadResults_T
	{
		parameter<string> type;       // 'lp' or 'greedy'
		parameter<string> assignment; // 'central' or 'nearest'
		///

		parameter<string> GDAL_DRIVER := 'Arrow';
		unit<uint32> ResultingClientAssignment
		:	StorageName = "='%localDataProjDir%/'+ProjName+'/'+ModelParameters/StudyArea+'/'+type+'/'+assignment+'/traveltime.arrow'"
		,	StorageType = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<min_f> t_ij;
		}

		attribute<min_f>             ClientTravelTime            (Client) := rjoin(ID(Client), convert(ResultingClientAssignment/id, Client), ResultingClientAssignment/t_ij);
		attribute<ClientTravelTimeK> ClientTravelTime_Classified (Client) := classify(ClientTravelTime, ClientTravelTimeK/ClassBreaks);

		unit<uint8> OpenEnum := range(0b, 3b)
		{
			attribute<string> label : [ 'Closed', 'Open', 'Underfilled'];
			container V := for_each_nedv(label, string(ID(.))+'[..]', void, .);
		}

		unit<uint32> ResultingFacilityClosure
		:	StorageName = "='%localDataProjDir%/'+ProjName+'/'+ModelParameters/StudyArea+'/'+type+'/'+assignment+'/assignment.arrow'"
		,	StorageType = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<Facility> id;
			attribute<OpenEnum> open;
		}
		attribute<OpenEnum> FacilityRemainsOpen (Facility) := rjoin(ID(Facility), convert(ResultingFacilityClosure/id, Facility), ResultingFacilityClosure/Open);

		unit<uint32> OpenFacilities := select_with_org_rel(FacilityRemainsOpen > OpenEnum/V/Closed)
		{
			attribute<BaseProjection> geometry := org_rel->Geometry;
		}

		attribute<Float64> FacilityProximity     (Base_grid_1km) := potential(Float64(IsDefined(invert(      Facility/geometry[Base_grid_1km]))), /Geography/Distmatrices/Impl/pot10000m/PotRange/AbsWeight);
		attribute<Float64> OpenFacilityProximity (Base_grid_1km) := potential(Float64(IsDefined(invert(OpenFacilities/geometry[Base_grid_1km]))), /Geography/Distmatrices/Impl/pot10000m/PotRange/AbsWeight);
		attribute<Float64> Openness              (Base_grid_1km) := OpenFacilityProximity / FacilityProximity;
	}

	// Reads the per-(cost-function, λ) Arrow files written by lambda_sweep_simplex.jl:
	//   %localDataProjDir%/<proj>/<StudyArea>/lambda_sweep/<func>/<w_label>/{traveltime,assignment}.arrow
	// Same outputs as ReadResults_T but on the λ-sweep path (function + w in the path),
	// so LINEAR/QUADRATIC/LOGISTIC scenarios at specific λ stay separable.
	Template ReadSweepResults_T
	{
		parameter<string> proj;     // 'NewPharmacies' (S1/S2 scenarios) or 'ExistingPharmacies' (baseline)
		parameter<string> func;     // 'LINEAR' | 'QUADRATIC' | 'LOGISTIC' | 'PIECEWISE'
		parameter<string> w_label;  // 'w=0.01' for a sweep point, 'baseline' for the existing situation
		///

		parameter<string> GDAL_DRIVER := 'Arrow';
		unit<uint32> ResultingClientAssignment
		:	StorageName = "='%localDataProjDir%/'+proj+'/'+ModelParameters/StudyArea+'/lambda_sweep/'+func+'/'+w_label+'/traveltime.arrow'"
		,	StorageType = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<min_f> t_ij;
		}

		attribute<min_f>             ClientTravelTime            (Client) := rjoin(ID(Client), convert(ResultingClientAssignment/id, Client), ResultingClientAssignment/t_ij);
		attribute<ClientTravelTimeK> ClientTravelTime_Classified (Client) := classify(ClientTravelTime, ClientTravelTimeK/ClassBreaks);

		unit<uint8> OpenEnum := range(0b, 3b)
		{
			attribute<string> label : [ 'Closed', 'Open', 'Underfilled'];
			container V := for_each_nedv(label, string(ID(.))+'[..]', void, .);
		}

		unit<uint32> ResultingFacilityClosure
		:	StorageName = "='%localDataProjDir%/'+proj+'/'+ModelParameters/StudyArea+'/lambda_sweep/'+func+'/'+w_label+'/assignment.arrow'"
		,	StorageType = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<Facility> id;
			attribute<OpenEnum> open;
		}
		attribute<OpenEnum> FacilityRemainsOpen (Facility) := rjoin(ID(Facility), convert(ResultingFacilityClosure/id, Facility), ResultingFacilityClosure/Open);

		unit<uint32> OpenFacilities := select_with_org_rel(FacilityRemainsOpen > OpenEnum/V/Closed)
		{
			attribute<BaseProjection> geometry := org_rel->Geometry;
		}

		attribute<Float64> FacilityProximity     (Base_grid_1km) := potential(Float64(IsDefined(invert(      Facility/geometry[Base_grid_1km]))), /Geography/Distmatrices/Impl/pot10000m/PotRange/AbsWeight);
		attribute<Float64> OpenFacilityProximity (Base_grid_1km) := potential(Float64(IsDefined(invert(OpenFacilities/geometry[Base_grid_1km]))), /Geography/Distmatrices/Impl/pot10000m/PotRange/AbsWeight);
		attribute<Float64> Openness              (Base_grid_1km) := OpenFacilityProximity / FacilityProximity;
	}

	Template Allocate_T
	{
		unit<uint32>      Org;
		unit<uint32>      Dest;
		container         NetwerkSpec;
		parameter<string> ProjName;
		///
		
		unit<uint32> Facility     := Dest;
	
		unit<uint32> FinalLinkSet := NetwerkSpec/CreateMoreEfficientNetwork/FinalSet/FinalLinkSet;
		unit<uint32> FinalNodeSet := NetwerkSpec/CreateMoreEfficientNetwork/FinalSet/FinalNodeSet;
	
		unit<uint64> Allocation :=
			impedance_matrix_od64(
				'bidirectional(link_flag);startPoint(Node_rel);endPoint(Node_rel);cut(OrgZone_max_imp);limit(OrgZone_max_mass,DstZone_mass);alternative(link_imp):alt_imp;od:OrgZone_rel,DstZone_rel,impedance'
				, FinalLinkSet/Impedance
				, FinalLinkSet/F1
				, FinalLinkSet/F2
				
				, !FinalLinkSet/IsOneDirection //link flag
				, FinalNodeSet/OrgNode_rel
				, FinalNodeSet/DestNode_rel
				, ModelParameters/max_traveltime_to_facility[s_f]    //OrgZone_max_imp
				, ModelParameters/max_nr_facilities_per_client , float64(Facility/CountCurrentObjects > 0f)  //limit (org max mass, dest mss)
				, FinalLinkSet/Lengthkm                              //alt imp
			)
		{
			unit<uint64> OD := .;
			attribute<Client>   client_rel   := OrgZone_rel;
			attribute<Facility> facility_rel := DstZone_rel;
			
			parameter<km>      MinDist                  := 0.001[km],    Descr = "Minimum distance to be used between i and j, to avoid zero distances.";
			parameter<s_f>     MinTime                  := 1[s_f],       Descr = "Minimum traveltime to be used between i and j, to avoid zero time.";
			parameter<float32> α                        := 1f,           Descr = "Scale factor in distance-decay function f(c)=Alpha*c^Beta.";
			parameter<float32> β                        := -2f,          Descr = "Distance-decay exponent (<0) controlling sensitivity to distance.";
			parameter<float32> PotRadiusKm              := 2.5f,         Descr = "Radius for local potential (km), used for finding kids around schools. Hack because we do not know the actual capacity per school"; 
			parameter<float32> γ                        := 1.0f,         Descr = "Capacity sensitivity, strength of feedback in destination reweighting: 0 -> round 2 = round 1; 0.5-1.0 -> mild correction towards capacity; 2-3 -> strong aggresive correction; >4 -> instabile possible oscillating";
			parameter<float32> W_floor                  := 0.25f,        Descr = "Lower bound for destination weight to prevent collapse.";
			parameter<float32> W_ceiling                := 4.0f,         Descr = "Upper bound for destination weight to limit over-attraction.";
			parameter<float32> UK_k                     := exp(-1.138f), Descr = "Scale term from UK school-size power law.";
			parameter<float32> UK_theta                 := 0.233f,       Descr = "Exponent from UK school-size power law (sublinear scaling).";
			parameter<uint8>   NumberOfIterations       := 5b,           Descr = "Number of iterations for balancing assignment.";
			
			attribute<float32> SchoolCount_j     (Dest) := Dest/Count_Objects_Per_Cell                                        , Descr = "Number of school facilities on destination cell j";
			attribute<float32> Pop_i              (Org) := ='float32(Org/'+Modelparameters/Client+')'                         , Descr = "Eligible student population in origin cell i";
			attribute<float32> LocalPotential_j  (Dest) := sum(Pop_i[client_rel] * float32(d_ij <= PotRadiusKm), facility_rel), Descr = "Eligible student population within PotRadiusKm of destination j.";
			attribute<float32> CapTarget_j       (Dest) := UK_k * pow(max_elem(LocalPotential_j, 1f), UK_theta)               , Descr = "Exogenous expected capacity per facility at destination j";
		
			attribute<float32> d_ij                     := value(max_elem(alt_imp, MinDist),float32)                          , Descr = "Distance between i and j"; 
			attribute<float32> t_ij                     := value(max_elem(impedance, MinTime),float32)                        , Descr = "Traveltime between i and j based on shortest travel path";
			attribute<float32> ClosestDist_i      (Org) := min(d_ij, client_rel)                                              , Descr = "Distance from origin i to its nearest school (min over j)";
			attribute<float32> c_ij                     := max_elem(d_ij - ClosestDist_i[client_rel], value(MinDist, float32)), Descr = "'Extra' distance beyond the nearest option"; 
			attribute<float32> Deterrence_ij            := α * c_ij^β                                                         , Descr = "Distance-decay weight based on surplus distance.";
			attribute<euro>    travelcost_ij            := float32(d_ij[km] * ModelParameters/cost_per_km);

			parameter<string> GDAL_DRIVER := 'Arrow';
			
			container DistanceTableExport
				:	StorageName = "='%localDataProjDir%/'+ProjName+'/'+ModelParameters/StudyArea+'_od.arrow'"
				,	StorageType = "gdalwrite.vect"
				,	StorageReadOnly = "False"
			{
				attribute<Client>    Client_rel   (OD) := ../client_rel;
				attribute<Facility>  facility_rel (OD) := ../facility_rel;
				attribute<float32>   t_ij         (OD) := ../t_ij;
				attribute<float32>   d_ij         (OD) := ../d_ij;
				attribute<float32>   travelcost_ij(OD) := ../travelcost_ij;
				attribute<float32>   Deterrence_ij(OD) := ../Deterrence_ij;
			}

			container SolverResults
			{
				parameter<string> GDAL_DRIVER := 'Arrow';

				container lp_central     := ReadResults_T('lp'    , 'central');
				container lp_nearest     := ReadResults_T('lp'    , 'nearest');
				container greedy_central := ReadResults_T('greedy', 'central');
				container greedy_nearest := ReadResults_T('greedy', 'nearest');
			}

			// --- λ-sweep scenarios for travel-time impact maps ----------------
			// S1 = closest to baseline #pharmacies; S2 = closest to baseline travel cost.
			// The S1/S2 λ(w) differ per region AND per travel-cost function, so we do NOT
			// hardcode w here: lambda_sweep_simplex.jl writes the chosen scenario to stable
			// folders lambda_sweep/<func>/S1 and /S2, and we reference those labels. The
			// path is region-agnostic via ModelParameters/StudyArea.
			// baseline reads the Existing-counterpart project (nearest existing pharmacy);
			// only baseline/ClientTravelTime is valid here — its facility-openness items
			// join existing-pharmacy ids onto this allocation's New Facility set, so use
			// the Existing allocation's SweepResults/baseline for an open-pharmacy map.
			container SweepResults
			{
				parameter<string> BaselineProj := replace(ProjName, 'New', 'Existing');

				container baseline  := ReadSweepResults_T(BaselineProj, 'QUADRATIC', 'baseline');

				container lin_S1    := ReadSweepResults_T(ProjName, 'LINEAR',    'S1');
				container lin_S2    := ReadSweepResults_T(ProjName, 'LINEAR',    'S2');
				container quad_S1   := ReadSweepResults_T(ProjName, 'QUADRATIC', 'S1');
				container quad_S2   := ReadSweepResults_T(ProjName, 'QUADRATIC', 'S2');
				container log_S1    := ReadSweepResults_T(ProjName, 'LOGISTIC',  'S1');
				container log_S2    := ReadSweepResults_T(ProjName, 'LOGISTIC',  'S2');

				// Travel-time impact vs baseline (negative = faster than existing situation).
				attribute<min_f> dT_lin_S1  (Client) := lin_S1/ClientTravelTime  - baseline/ClientTravelTime;
				attribute<min_f> dT_lin_S2  (Client) := lin_S2/ClientTravelTime  - baseline/ClientTravelTime;
				attribute<min_f> dT_quad_S1 (Client) := quad_S1/ClientTravelTime - baseline/ClientTravelTime;
				attribute<min_f> dT_quad_S2 (Client) := quad_S2/ClientTravelTime - baseline/ClientTravelTime;
				attribute<min_f> dT_log_S1  (Client) := log_S1/ClientTravelTime  - baseline/ClientTravelTime;
				attribute<min_f> dT_log_S2  (Client) := log_S2/ClientTravelTime  - baseline/ClientTravelTime;
			}

			container Summary
			{
				attribute<min_f>             ClientTravelTime_lp_central                (Client)        := SolverResults/lp_central/ClientTravelTime;
				attribute<ClientTravelTimeK> ClientTravelTime_Classified_lp_central     (Client)        := SolverResults/lp_central/ClientTravelTime_Classified;
				attribute<Float64>           Openness_lp_central                        (Base_grid_1km) := SolverResults/lp_central/Openness;
				attribute<min_f>             ClientTravelTime_lp_nearest                (Client)        := SolverResults/lp_nearest/ClientTravelTime;
				attribute<ClientTravelTimeK> ClientTravelTime_Classified_lp_nearest     (Client)        := SolverResults/lp_nearest/ClientTravelTime_Classified;
				attribute<Float64>           Openness_lp_nearest                        (Base_grid_1km) := SolverResults/lp_nearest/Openness;
				attribute<min_f>             ClientTravelTime_greedy_central            (Client)        := SolverResults/greedy_central/ClientTravelTime;
				attribute<ClientTravelTimeK> ClientTravelTime_Classified_greedy_central (Client)        := SolverResults/greedy_central/ClientTravelTime_Classified;
				attribute<Float64>           Openness_greedy_central                    (Base_grid_1km) := SolverResults/greedy_central/Openness;
				attribute<min_f>             ClientTravelTime_greedy_nearest            (Client)        := SolverResults/greedy_nearest/ClientTravelTime;
				attribute<ClientTravelTimeK> ClientTravelTime_Classified_greedy_nearest (Client)        := SolverResults/greedy_nearest/ClientTravelTime_Classified;
				attribute<Float64>           Openness_greedy_nearest                    (Base_grid_1km) := SolverResults/greedy_nearest/Openness;
			}
			
			container ClientExport
			:	StorageName = "='%localDataProjDir%/'+ProjName+'/'+ModelParameters/StudyArea+'_i.arrow'"
			,	StorageType = "gdalwrite.vect"
			,	StorageReadOnly = "False"
			{
				attribute<client>  id        (client) := id(client);
				attribute<float32> pop       (client) := Pop_i;
				attribute<float32> total_pop (client) := float32(client/population);
				attribute<float64> x         (client) := client/x;
				attribute<float64> y         (client) := client/y;
			}
			
			container FacilityExport
			:	StorageName = "='%localDataProjDir%/'+ProjName+'/'+ModelParameters/StudyArea+'_j.arrow'"
			,	StorageType = "gdalwrite.vect"
			,	StorageReadOnly = "False"
			{
				attribute<Facility> id(Facility) := id(Facility);
				attribute<float64> x   (Facility) := Get_X( Facility/geometry );
				attribute<float64> y   (Facility) := Get_Y( Facility/geometry );
			}
			
			//Inital round 
			attribute<float32> DestWeight_j_init (Dest) := const(1f, Dest)                                                    , Descr = "Initial destination weight";
			attribute<float32> A_i_r0             (Org) := 1f / sum(DestWeight_j_init[facility_rel] * Deterrence_ij, client_rel), Descr = "Round-1 origin balancing factor A_i.";
			attribute<float32> F_ij_r0                  := Pop_i[client_rel] * A_i_r0[client_rel] * DestWeight_j_init[facility_rel] * Deterrence_ij, Descr = "Round-1 flow from origin i to destination j.";
			attribute<float32> Assignment_j_r0   (Dest) := sum(F_ij_r0, facility_rel)                                          , Descr = "Round-1 assignment to destination j.";
			attribute<float32> MeanSize_j_r0     (Dest) := Assignment_j_r0 / SchoolCount_j                                    , Descr = "Round-1 realized mean size per facility at j.";

			// Final outputs
			container results 
			{
				attribute<float32> FinalSize_j         (Dest) := Iters/LastIter/MeanSize_j                                          , Descr = "Final mean size per facility.";
				attribute<float32> F_ij                  (OD) := Iters/LastIter/F_ij                                                , Descr = "Final OD allocation";
				attribute<float32> F_i                  (Org) := sum(F_ij, client_rel); 
				attribute<float32> mean_imp             (Org) := sum(F_ij * float32(impedance)) / F_i;
				attribute<float32> min_imp              (Org) := min(F_ij* (float32(impedance) / F_ij), client_rel);
				
				attribute<euro>    travel_costs         (Org) := sum(F_ij * travelcost_ij, client_rel) / F_i;
				attribute<float32> F_j                 (Dest) := sum(F_ij, facility_rel); 
				attribute<euro>    CostFactor_j        (Dest) := ModelParameters/ConstCostsPerFacility / F_j; 
				
				attribute<euro>    total_facility_costs (Org) := sum(F_ij * CostFactor_j[facility_rel], client_rel);
				attribute<euro>    avg_facility_costs   (Org) := total_facility_costs / Pop_i;
				attribute<euro>    avg_costs            (Org) := travel_costs + avg_facility_costs;
				attribute<euro>    total_costs          (Org) := travel_costs * Pop_i + total_facility_costs;
				
	//			attribute<float32> CatchmentShare_ij        := F_ij / max_elem(Pop_i[client_rel], 1f)                            , Descr = "Final share of origin i to destination j.";
				// TODO: number of (un)serviced clients
				// TODO: mean/max impedance to Facility
			}
		
			container Iters :=
				for_each_ne(
					Iter/name
					,'Iter_T('+quote(Iter/PrevName)+')'
				), Descr = ""
			{
				container Iter_0
				{
					attribute<float32> MeanSize_j (Dest) := OD/MeanSize_j_r0;
				}
				container LastIter := =last(Iter/name);
			}
			unit<UInt8> Iter := cat_range(1b, NumberOfIterations + 1b)
			{
				attribute<String> name        := 'Iter_'+string(id(.));
				attribute<Bool>   IsFirstIter := id(.) == 1b;
				attribute<String> PrevName    := IsFirstIter ? 'Iter_0' : name[id(.) - min_elem( id(.), 1b)];
				attribute<String> Label       := name;
			}
		}
		

		Template Iter_T
		{
			parameter<string> PrevIterName;
			container PrevIter := =PrevIterName;
			///
			attribute<float32> MeanSize_j_Prev   (Dest) := PrevIter/MeanSize_j;
			
			attribute<float32> CapRatio_j        (Dest) := MeanSize_j_Prev / max_elem(CapTarget_j, 1f)                                          , Descr = "Load relative to target capacity (previous iter).";
			attribute<float32> DestWeight_j_adj  (Dest) := min_elem(max_elem(pow(max_elem(CapRatio_j, 1e-3f), -γ), W_floor), W_ceiling)         , Descr = "Adjusted destination weight (oversubscribed -> lower weight).";
			attribute<float32> A_i                (Org) := 1f / sum(DestWeight_j_adj[facility_rel] * Deterrence_ij, client_rel)                 , Descr = "Origin balancing factor.";
			attribute<float32> F_ij                (OD) := Pop_i[client_rel] * A_i[client_rel] * DestWeight_j_adj[facility_rel] * Deterrence_ij, Descr = "Rebalanced flow.";
			attribute<float32> Assignment_j      (Dest) := sum(F_ij, facility_rel)                                                             , Descr = "Assignment to destination j";
			attribute<float32> MeanSize_j        (Dest) := Assignment_j / float32(SchoolCount_j)                                                , Descr = "Mean size per facility";
		}
	}
	
	container StudentAccessibility
	{
		unit<uint32> Org          := Client;                         // populated cells (j)
		unit<uint32> Dest         := Base_grid_1km/points;           // alle cellen (i)
		container    NetwerkSpec  := NetworkSetup/StudentAccess_Analysis/NetwerkSpec;
		unit<uint32> FinalLinkSet := NetwerkSpec/CreateMoreEfficientNetwork/FinalSet/FinalLinkSet;
		unit<uint32> FinalNodeSet := NetwerkSpec/CreateMoreEfficientNetwork/FinalSet/FinalNodeSet;

		unit<uint64> OD :=
			impedance_matrix_od64(
				'bidirectional(link_flag);startPoint(Node_rel);endPoint(Node_rel);cut(OrgZone_max_imp);od:OrgZone_rel,DstZone_rel,impedance'
				, FinalLinkSet/Impedance
				, FinalLinkSet/F1
				, FinalLinkSet/F2
				
				, !FinalLinkSet/IsOneDirection
				, FinalNodeSet/OrgNode_rel
				, FinalNodeSet/DestNode_rel
				, 1800[s_f]   // 30 min cutoff
			)
		{
			attribute<s_f>        t_ji     := max_elem(impedance, 1[s_f]);   // voorkom delen door 0
			attribute<min_f>      t_min    := t_ji[min_f];
			attribute<uint32>     Pop_j    := Org/Pop_PrimarySchool[OrgZone_rel];
			attribute<float32>    contrib  := float32(Pop_j) / value(t_min * t_min, float32);
		}

		// Resultaat: één score per cel
		attribute<float32> StudentAccessibility                           (Dest) := sum(OD/contrib, OD/DstZone_rel);
		
		attribute<float32> StudentAccessibility_grid (SourceData/Locations/Base_grid) := sum(StudentAccessibility, Dest/geometry[SourceData/Locations/Base_grid]);
		attribute<uint32>  NumberOfSchools_grid      (SourceData/Locations/Base_grid) := /SourceData/Locations/Schools/within_StudyArea/uq_school_cells/CountSchools_grid;
		attribute<bool>    access_criterion_sel		 (SourceData/Locations/Base_grid) := StudentAccessibility_grid > exp(2f) && StudentAccessibility_grid < exp(10f) && SourceData/Locations/Population_2011_Ardeco/ReadData[uint32] > 0;
		attribute<bool>	   schools_present_sel		 (SourceData/Locations/Base_grid) := isdefined(Geography/Base_grid_1km/Country_rel) && NumberOfSchools_grid > 0;
		attribute<bool>    search_space				 (SourceData/Locations/Base_grid) := schools_present_sel || access_criterion_sel;
		
		unit<uint64> study_area_grid:= select_with_org_rel(isdefined(Geography/Base_grid_1km/Country_rel)) {
			attribute<float32> sel_StudentAccessibility_grid := StudentAccessibility_grid[org_rel];
			attribute<uint32>  sel_NumberOfSchools_grid      := NumberOfSchools_grid[org_rel];
		}
		
		
	}
}